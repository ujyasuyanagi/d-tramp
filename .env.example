JWT_SECRET=dev-secret-change-me
MONGO_URL=mongodb://localhost:27017/dtramp
USER_SERVICE_URL=http://localhost:4001
TRIP_SERVICE_URL=http://localhost:4002
MAP_SERVICE_URL=http://localhost:4003
GATEWAY_PORT=4000
# Города парка (services/map-service/src/cities.ts). Пусто — все: Москва, крупные города
# области и столицы ЦФО. Можно сузить: MAP_CITIES=msk; tver или свою точку
# MAP_CITIES=54.196,37.618,71 (для неё же свой граф OSRM и радиус ниже).
MAP_CITIES=
MAP_ADHOC_RADIUS_KM=8
MAP_DRIVER_COUNT=90
# Радиус поиска машины (пунктирный круг), км.
MAP_RADIUS_KM=3
# Минимум машин вокруг точки поиска: меньше — свободные из окрестностей перегоняются ближе.
MAP_MIN_NEAR=6

# Реальные дороги (OSRM). Для docker compose оставить как есть;
# при npm run dev на хосте — http://localhost:5002 (порт проброшен из контейнера osrm).
OSRM_URL=http://osrm:5000
OSRM_MAP_NAME=moscow-csfo-roads

# Host-порты compose. Нужны, чтобы CI-стек (dtramp-ci) не конфликтовал с рабочим:
# 27018, 4100-4103, 8180. Обычный запуск оставляет значения по умолчанию.
# MONGO_HOST_PORT=27017
# USER_HOST_PORT=4001
# TRIP_HOST_PORT=4002
# MAP_HOST_PORT=4003
# GATEWAY_HOST_PORT=4000
# OSRM_HOST_PORT=5002
# WEB_HOST_PORT=8080
